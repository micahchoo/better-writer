# dependencies
node_modules/

# build output
dist/
web/dist/
.vite/
*.tsbuildinfo

# secrets — .env holds model endpoints and STT paths; never commit
.env
.env.*
!.env.example

# local data — the writer's drafts and everything the app writes at runtime
data/

