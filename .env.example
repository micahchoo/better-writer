# Local model endpoint — llama.cpp or Ollama serve /v1/chat/completions
BW_LLM_BASE_URL=http://127.0.0.1:8088/v1
BW_LLM_MODEL=bonsai-27b

# Optional: local Parakeet STT model directory (dictation disabled without it)
# BW_STT_MODEL_DIR=/path/to/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8

# Server bind (optional)
# BW_HOST=127.0.0.1
# BW_PORT=4517
